# Supabase — a NEW, independent Supabase project for WiszMe
# (stores only Good Morning / Good Night wishes — the other categories
# live on their own products' existing Supabase projects).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit — for photo uploads
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Used to build the shareable /good-morning/[slug] and /good-night/[slug]
# links on the success screen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayHere — for the "remove watermark" paid option
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
